@model List<CaféPourLaVie.Models.CartItem>


@{
    ViewData["Title"] = "Giỏ hàng";
}


<h2>
    Giỏ hàng
</h2>



@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Chưa có sản phẩm nào.
    </div>

    <a asp-action="Index" class="btn btn-primary">
        Quay lại bán hàng
    </a>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th> Sản phẩm </th>
                <th> Giá </th>
                <th> Số lượng </th>
                <th> Thành tiền </th>
                <th> </th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td> @item.ProductName </td>

                    <td> @item.Price.ToString("N0") đ </td>
                     
                    <td>
                        <a asp-action="Decrease" asp-route-id="@item.ProductId" class="btn btn-outline-danger btn-sm">
                            -
                        </a>

                        <span class="mx-2"> @item.Quantity </span>

                        <a asp-action="Increase" asp-route-id="@item.ProductId" class="btn btn-outline-success btn-sm">
                            +
                        </a>
                    </td>
                     
                    <td> @item.SubTotal.ToString("N0") đ </td>
                     
                    <td>
                         <a asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">
                             Xóa 
                         </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


    <h4>

        Tổng tiền:

        @Model.Sum(x => x.SubTotal).ToString("N0") đ

    </h4>


    <a asp-action="Index" class="btn btn-secondary">
        Thêm món
    </a>

    <a asp-action="Checkout" class="btn btn-success">
        Thanh toán
    </a>
}