@model List<CartItem>


<h2>Thanh toán</h2>


<h4>Sản phẩm</h4>

@foreach (var item in Model)
{
    <p>
        @item.ProductName
        -
        @item.Quantity
        -
        @item.SubTotal
    </p>
}


<form asp-action="Checkout" method="post">

    <label>
        Phương thức thanh toán
    </label>


    <select name="paymentMethodId" class="form-control">
        @foreach (var pm in ViewBag.PaymentMethods)
        {
            <option value="@pm.PaymentMethodId">
                @pm.MethodName
            </option>
        }
    </select>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            Thanh toán
        </button>

        <a asp-action="Cart" class="btn btn-secondary ms-2">
            Quay lại
        </a>
    </div>
</form>