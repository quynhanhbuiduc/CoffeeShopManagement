@model CaféPourLaVie.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<h2>Thêm sản phẩm</h2>

<div asp-validation-summary="All"
     class="text-danger">
</div>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        <strong>Không thể thêm sản phẩm!</strong>
        <br />
        @ViewData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="mb-3">

        <label asp-for="ProductName"></label>

        <input asp-for="ProductName" class="form-control" />

        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>

    <div class="mb-3">

        <label asp-for="Description"></label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>

    </div>

    <div class="mb-3">

        <label asp-for="Price"></label>

        <input asp-for="Price" type="number"
               min="0" step="1000" class="form-control" />

        <span asp-validation-for="Price" class="text-danger"></span>
    
    </div>

    <div class="mb-3">

        <label asp-for="Quantity"></label>

        <input asp-for="Quantity" type="number"
               min="0" class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Image"></label>

        <input type="file"
               name="imageFile"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label>Danh mục</label>

        <select asp-for="CategoryId"
                asp-items="ViewBag.CategoryId"
                class="form-select">

            <option value="">-- Chọn danh mục --</option>

        </select>

    </div>

    <!-- <div class="mb-3">

        <label asp-for="CreatedDate"></label>

        <input asp-for="CreatedDate" type="date" class="form-control" />
     </div> -->

    <button class="btn btn-success">
        Lưu
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>

